{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/app(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/social", "destination": "/api/index.js" },
    { "source": "/pinyin-chart", "destination": "/api/index.js" },
    { "source": "/printable/(.*)", "destination": "/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api|app|admin|social|pinyin-chart|printable|uploads).*\\..*)", "destination": "/public/$1" },
    { "source": "/", "destination": "/api/index.js" }
  ]
}
